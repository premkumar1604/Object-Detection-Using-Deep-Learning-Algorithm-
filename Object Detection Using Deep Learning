import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score


# ============================================================
# STEP 1: LOAD DATA
# ============================================================

file_path = r"E:\python\basic\weather.csv"

try:
    df = pd.read_csv(file_path)
    print("\nDataset loaded successfully!")
except FileNotFoundError:
    print(f"\nERROR: Dataset not found at:\n{file_path}")
    exit()


# ============================================================
# STEP 2: DATA EXPLORATION
# ============================================================

print("\n========== FIRST 5 ROWS ==========")
print(df.head())

print("\n========== DATASET INFORMATION ==========")
print(df.info())

print("\n========== STATISTICAL SUMMARY ==========")
print(df.describe())

print("\n========== MISSING VALUES ==========")
print(df.isnull().sum())


# ============================================================
# STEP 3: HANDLE MISSING VALUES
# ============================================================

# Check required columns
required_columns = [
    "Date",
    "MinTemp",
    "MaxTemp",
    "Rainfall",
    "Humidity9am",
    "WindSpeed9am"
]

missing_columns = [
    column for column in required_columns
    if column not in df.columns
]

if missing_columns:
    print("\nERROR: Missing columns:")
    print(missing_columns)
    exit()


# Convert Date column
df["Date"] = pd.to_datetime(df["Date"], errors="coerce")

# Remove rows with missing values in important columns
df = df.dropna(
    subset=[
        "Date",
        "MinTemp",
        "MaxTemp",
        "Rainfall"
    ]
)


# ============================================================
# STEP 4: FEATURE ENGINEERING
# ============================================================

df["Month"] = df["Date"].dt.month

df["Year"] = df["Date"].dt.year


# ============================================================
# STEP 5: PAIRPLOT
# ============================================================

print("\nCreating pairplot...")

sns.pairplot(
    df[
        [
            "MinTemp",
            "MaxTemp",
            "Rainfall",
            "Humidity9am",
            "WindSpeed9am"
        ]
    ].dropna()
)

plt.suptitle(
    "Pairplot of Weather Features",
    y=1.02
)

plt.show()


# ============================================================
# STEP 6: MONTHLY ANALYSIS
# ============================================================

monthly_avg_max_temp = (
    df.groupby("Month")["MaxTemp"]
    .mean()
)

monthly_avg_temp = (
    df.groupby("Month")[["MaxTemp", "MinTemp"]]
    .mean()
)

monthly_avg_rainfall = (
    df.groupby("Month")["Rainfall"]
    .mean()
)

print("\n========== MONTHLY AVERAGE MAX TEMPERATURE ==========")
print(monthly_avg_max_temp)

print("\n========== MONTHLY AVERAGE TEMPERATURE ==========")
print(monthly_avg_temp)

print("\n========== MONTHLY AVERAGE RAINFALL ==========")
print(monthly_avg_rainfall)


# ============================================================
# STEP 7: CORRELATION HEATMAP
# ============================================================

plt.figure(figsize=(12, 8))

numeric_columns = df.select_dtypes(
    include=np.number
)

correlation_matrix = numeric_columns.corr()

sns.heatmap(
    correlation_matrix,
    annot=True,
    fmt=".2f",
    cmap="coolwarm",
    square=True
)

plt.title("Weather Data Correlation Heatmap")
plt.tight_layout()
plt.show()


# ============================================================
# STEP 8: RAINFALL BOXPLOT
# ============================================================

plt.figure(figsize=(8, 6))

sns.boxplot(
    x=df["Rainfall"]
)

plt.title("Rainfall Distribution")
plt.xlabel("Rainfall (mm)")

plt.tight_layout()
plt.show()


# ============================================================
# STEP 9: RAINFALL BY MONTH
# ============================================================

plt.figure(figsize=(10, 6))

sns.violinplot(
    x="Month",
    y="Rainfall",
    data=df
)

plt.title("Rainfall Distribution by Month")
plt.xlabel("Month")
plt.ylabel("Rainfall (mm)")

plt.grid(True)

plt.tight_layout()
plt.show()


# ============================================================
# STEP 10: MONTHLY TEMPERATURE
# ============================================================

plt.figure(figsize=(10, 6))

plt.plot(
    monthly_avg_temp.index,
    monthly_avg_temp["MaxTemp"],
    marker="o",
    label="Average Max Temperature"
)

plt.plot(
    monthly_avg_temp.index,
    monthly_avg_temp["MinTemp"],
    marker="o",
    label="Average Min Temperature"
)

plt.title("Monthly Average Temperatures")

plt.xlabel("Month")

plt.ylabel("Temperature (°C)")

plt.xticks(
    monthly_avg_temp.index
)

plt.legend()

plt.grid(True)

plt.tight_layout()

plt.show()


# ============================================================
# STEP 11: RAINFALL TIME SERIES
# ============================================================

plt.figure(figsize=(14, 6))

plt.plot(
    df["Date"],
    df["Rainfall"],
    linestyle="-"
)

plt.title("Daily Rainfall Over Time")

plt.xlabel("Date")

plt.ylabel("Rainfall (mm)")

plt.xticks(rotation=45)

plt.grid(True)

plt.tight_layout()

plt.show()


# ============================================================
# STEP 12: MACHINE LEARNING
# RAINFALL PREDICTION USING LINEAR REGRESSION
# ============================================================

print("\n========================================")
print("RAINFALL PREDICTION MODEL")
print("========================================")


# Features
X = df[
    [
        "MinTemp",
        "MaxTemp"
    ]
]

# Target
y = df["Rainfall"]


# Remove any remaining missing values
model_data = pd.concat(
    [X, y],
    axis=1
).dropna()

X = model_data[
    [
        "MinTemp",
        "MaxTemp"
    ]
]

y = model_data["Rainfall"]


# ============================================================
# STEP 13: TRAIN TEST SPLIT
# ============================================================

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42
)

print("\nTraining samples:", len(X_train))
print("Testing samples:", len(X_test))


# ============================================================
# STEP 14: TRAIN MODEL
# ============================================================

model = LinearRegression()

model.fit(
    X_train,
    y_train
)


# ============================================================
# STEP 15: PREDICTION
# ============================================================

y_pred = model.predict(X_test)


# ============================================================
# STEP 16: MODEL EVALUATION
# ============================================================

mse = mean_squared_error(
    y_test,
    y_pred
)

rmse = np.sqrt(mse)

mae = mean_absolute_error(
    y_test,
    y_pred
)

r2 = r2_score(
    y_test,
    y_pred
)


print("\n========== MODEL RESULTS ==========")

print("Mean Squared Error (MSE):", mse)

print("Root Mean Squared Error (RMSE):", rmse)

print("Mean Absolute Error (MAE):", mae)

print("R² Score:", r2)


# ============================================================
# STEP 17: MODEL COEFFICIENTS
# ============================================================

print("\n========== MODEL COEFFICIENTS ==========")

print(
    "MinTemp coefficient:",
    model.coef_[0]
)

print(
    "MaxTemp coefficient:",
    model.coef_[1]
)

print(
    "Intercept:",
    model.intercept_
)


# ============================================================
# STEP 18: ACTUAL VS PREDICTED RAINFALL
# ============================================================

plt.figure(figsize=(10, 6))

plt.scatter(
    y_test,
    y_pred
)

plt.xlabel("Actual Rainfall (mm)")

plt.ylabel("Predicted Rainfall (mm)")

plt.title(
    "Actual vs Predicted Rainfall"
)

plt.grid(True)

plt.tight_layout()

plt.show()


# ============================================================
# STEP 19: PREDICT RAINFALL FOR NEW DATA
# ============================================================

print("\n========================================")
print("NEW RAINFALL PREDICTION")
print("========================================")

min_temp = float(
    input("Enter Minimum Temperature (°C): ")
)

max_temp = float(
    input("Enter Maximum Temperature (°C): ")
)


new_data = pd.DataFrame(
    {
        "MinTemp": [min_temp],
        "MaxTemp": [max_temp]
    }
)

predicted_rainfall = model.predict(
    new_data
)[0]


# Rainfall cannot realistically be negative
predicted_rainfall = max(
    0,
    predicted_rainfall
)


print(
    f"\nPredicted Rainfall: "
    f"{predicted_rainfall:.2f} mm"
)

print("\nProgram completed successfully!")